{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/fyi-archive/schemas/wayback-replay-configuration.schema.json",
  "title": "Transport-independent Wayback replay configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "selection_sha256", "members", "replay_policy_sha256",
    "producer", "producer_version", "parser_version", "jitter_seed", "policy"
  ],
  "properties": {
    "schema": {"const": "fyi-archive.wayback-replay-configuration.v1"},
    "selection_sha256": {"$ref": "#/$defs/sha256"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["member_id", "canonical_url", "capture_timestamp"],
        "properties": {
          "member_id": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "capture_timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "replay_policy_sha256": {"$ref": "#/$defs/sha256"},
    "producer": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "parser_version": {"type": "string", "minLength": 1},
    "jitter_seed": {"type": "integer"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_seconds", "ceiling_seconds", "backoff_multiplier", "jitter_fraction",
        "decay_factor", "circuit_seconds", "circuit_consecutive_failures",
        "failure_ratio", "window_size", "minimum_window"
      ],
      "properties": {
        "floor_seconds": {"type": "number", "minimum": 0},
        "ceiling_seconds": {"type": "number", "exclusiveMinimum": 0},
        "backoff_multiplier": {"type": "number", "minimum": 1},
        "jitter_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "decay_factor": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "circuit_seconds": {"type": "number", "minimum": 0},
        "circuit_consecutive_failures": {"type": "integer", "minimum": 1},
        "failure_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "window_size": {"type": "integer", "minimum": 1},
        "minimum_window": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
