{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/fyi-archive/schemas/wayback-cdx-approval-registry.schema.json",
  "title": "Externally registered approved CDX evidence pairs",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "approvals"],
  "properties": {
    "schema": {"const": "fyi-archive.wayback-cdx-approval-registry.v1"},
    "registry_id": {"type": "string", "minLength": 1},
    "approvals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "approval_id", "artifact_sha256", "retrieval_evidence_sha256",
          "endpoint", "query_scope", "producer_id", "retrieved_at", "disposition"
        ],
        "properties": {
          "approval_id": {"type": "string", "minLength": 1},
          "artifact_sha256": {"$ref": "#/$defs/sha256"},
          "retrieval_evidence_sha256": {"$ref": "#/$defs/sha256"},
          "endpoint": {"const": "https://web.archive.org/cdx/search/cdx"},
          "query_scope": {"type": "string", "format": "uri", "pattern": "^https://"},
          "producer_id": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "disposition": {"const": "approved_for_pending_replacement_candidates_only"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
