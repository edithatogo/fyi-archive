{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/fyi-archive/schemas/archive-instances.schema.json",
  "title": "fyi-archive instance registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "instances"],
  "properties": {
    "schema_version": { "const": 1 },
    "instances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/instance" }
    }
  },
  "$defs": {
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "base_url",
        "country",
        "locale",
        "hf_repo_id",
        "rate_limit_name",
        "status",
        "title",
        "source",
        "catalog_url",
        "source_modes",
        "seed_cap"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "base_url": { "type": "string", "format": "uri", "pattern": "^https://[^/]+$" },
        "country": { "type": "string", "minLength": 2 },
        "locale": { "type": "string", "pattern": "^[a-z]{2,3}-[A-Z]{2}$" },
        "hf_repo_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "rate_limit_name": { "type": "string", "minLength": 1 },
        "status": { "enum": ["supported", "experimental", "historical-only"] },
        "title": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "format": "uri", "pattern": "/$" },
        "catalog_url": {
          "oneOf": [
            { "type": "string", "format": "uri" },
            { "type": "null" }
          ]
        },
        "source_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "live_api",
              "atom_feed",
              "authority_catalog",
              "internet_archive",
              "official_dataset",
              "operator_export"
            ]
          }
        },
        "seed_cap": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
