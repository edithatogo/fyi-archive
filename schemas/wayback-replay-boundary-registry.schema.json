{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/fyi-archive/schemas/wayback-replay-boundary-registry.schema.json",
  "title": "Externally pinned Wayback replay boundary registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_id", "profiles"],
  "properties": {
    "schema": {"const": "fyi-archive.wayback-replay-boundary-registry.v1"},
    "registry_id": {"const": "fyi-archive-wayback-boundaries-v1"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id", "archive_hosts", "allowed_content_types", "max_payload_bytes"
        ],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "archive_hosts": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}
          },
          "allowed_content_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
            }
          },
          "max_payload_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
