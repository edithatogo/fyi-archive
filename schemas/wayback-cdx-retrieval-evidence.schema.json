{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/edithatogo/fyi-archive/schemas/wayback-cdx-retrieval-evidence.schema.json",
  "title": "Internet Archive CDX retrieval provenance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "artifact_sha256", "endpoint", "query_scope", "producer_id",
    "retrieved_at"
  ],
  "properties": {
    "schema": {"const": "fyi-archive.wayback-cdx-retrieval-evidence.v1"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "endpoint": {"const": "https://web.archive.org/cdx/search/cdx"},
    "query_scope": {"type": "string", "format": "uri", "pattern": "^https://"},
    "producer_id": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
